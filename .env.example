# Copy to repo root: cp .env.example .env (Next.js loads it from the monorepo root)
DATABASE_URL=postgres://kudos:kudos@localhost:5432/kudos
REDIS_URL=redis://localhost:6379
SESSION_SECRET=
TYPESAFE_API_KEY=
MAGIC_HOUR_API_KEY=
MAGIC_HOUR_WEBHOOK_SECRET=
# Optional ceremony tuning (see Magic Hour API docs)
# MAGIC_HOUR_HOST_VOICE=Morgan Freeman
# MAGIC_HOUR_TTV_MODEL=ltx-2.5
# MAGIC_HOUR_TTV_RESOLUTION=480p
OBJECT_STORE=local
OBJECT_STORE_DIR=.data
# Extra CSRF origins, comma-separated. The request host is always allowed.
APP_ORIGIN=
# Cloudflare R2. Used only when OBJECT_STORE=r2. Downloads are presigned.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# React Bits Pro license. Read by the shadcn CLI from the environment; do not commit the real key.
# REACTBITS_LICENSE_KEY=
# Set to 1 to disable IP rate limits (limits are also off when NODE_ENV=development).
# RATE_LIMIT_DISABLED=1
